# Gebeta environment example
#
# Copy the client section into apps/mobile/.env. That file is gitignored and
# must never be committed. Only EXPO_PUBLIC_* values reach the app bundle, and
# every one of them is public by design, so nothing secret may be added there.

# ---------------------------------------------------------------------------
# Expo client (apps/mobile/.env)
# ---------------------------------------------------------------------------

# Supabase project URL, from Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...), or the legacy anon key. This key is
# safe in a browser: it carries no privileges of its own and every request it
# makes is still filtered by row level security.
#
# Never put a secret key (sb_secret_...) or a service-role JWT here. Gebeta
# checks for them at startup and refuses to create a client.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public origin of the deployed web demo, used so provider QR codes encode a
# browser URL instead of the gebeta:// app link. A public address, not a
# secret. On the web the app reads window.location.origin and ignores this.
# EXPO_PUBLIC_WEB_BASE_URL=https://your-deployment.vercel.app

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets
#
# These are set on the server, never in a file that the app reads:
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=gemini-2.5-flash
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected
# into deployed functions automatically and must not be set by hand.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
