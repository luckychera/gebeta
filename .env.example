# Gebeta environment example
#
# Phase 1 (what runs today: the Expo client in apps/mobile) needs no secrets.
# Everything below is either public or reserved for the future backend.

# Public origin of the deployed web demo, used so provider QR codes encode a
# browser URL instead of the gebeta:// app link. This is a public address, not
# a secret. On the web the app reads window.location.origin and ignores this.
# EXPO_PUBLIC_WEB_BASE_URL=https://your-deployment.vercel.app

# Phase 2 only. These belong to the future Express backend and must never be
# added to the Expo client or to any EXPO_PUBLIC_ variable.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=
